# Copy to .env and fill in. .env is gitignored; never commit a key.

# The Meta Model API key. Prefer a file outside the repository (or a Docker /
# Kubernetes secret); META_API_KEY also works for platforms without files.
META_API_KEY_FILE=~/.config/plomba/meta.key
# META_API_KEY=

# Any endpoint that serves Meta models through the Responses API.
# META_API_BASE_URL=https://api.meta.ai/v1
# META_VISION_MODEL=muse-spark-1.3
# META_SEGMENTATION_MODEL=sam-3.1
# META_REASONING_EFFORT=low

# Database and photos. Keep outside the repository.
DATA_DIR=~/.local/share/plomba

PORT=8787
# LOG_LEVEL=info
