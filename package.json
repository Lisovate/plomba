{
  "name": "plomba",
  "version": "0.1.0",
  "private": true,
  "description": "A digital seal on a shipping container's condition at every handover.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @plomba/server",
    "dev:web": "npm run dev --workspace @plomba/web",
    "build": "npm run build --workspace @plomba/web",
    "start": "npm run start --workspace @plomba/server",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e && tsc -p examples",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
