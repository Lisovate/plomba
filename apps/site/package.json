{
  "name": "@plomba/site",
  "version": "0.1.0",
  "private": true,
  "description": "Plomba's product website: static pages generated at build time, and a small server for them and the Cloud waitlist.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning src/build.ts",
    "dev": "node --watch-path=src --watch-path=server --watch-path=public --disable-warning=ExperimentalWarning server/dev.ts",
    "start": "node server/main.ts",
    "images": "node scripts/make-images.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@plomba/core": "*",
    "lucide-static": "^1.67.0",
    "sharp": "^0.35.5"
  }
}
